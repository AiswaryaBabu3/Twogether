# ==============================================================================
# Twogether Backend Configuration (.env)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
# Supabase Pooler (Seoul ap-northeast-2, port 5432 - IPv4 compatible & supports Alembic migrations):
DATABASE_URL=postgresql://postgres.kzxllpwcaynyddkzypro:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PROTOCOL=2
REDIS_CONNECT_TIMEOUT=3.0
